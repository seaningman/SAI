{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/arch.txt",
    "color": { "1": "blue" },
    "padding": { "right": 4 }
  },
  "display": { "separator": "  " },
  "modules": [
    "break",
    { "type": "os", "key": "os   " },
    { "type": "kernel", "key": "kern " },
    { "type": "packages", "key": "pkgs " },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm   " },
    { "type": "terminal", "key": "term " },
    { "type": "cpu", "key": "cpu  " },
    { "type": "memory", "key": "mem  " },
    { "type": "uptime", "key": "up   " }
  ]
}
